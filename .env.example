# =============================================================================
# LiteLLM gateway — the single source of truth for agents, MCP tools and models
# =============================================================================
# Hosted proxy base URL (no trailing slash). Replace with your environment.
LITELLM_BASE_URL=https://litellm.your-domain.example
# Virtual key for THIS orchestrator, scoped to the agents + MCP servers it may use.
# Never put the master/admin key here.
LITELLM_API_KEY=sk-...
# CLI-ONLY. Read by `python -m orchestrator.admin.onboarding` (check/register/verify/smoke)
# to reach /v1/agents and /key|/team|/model management. The orchestrator runtime never
# reads it: every gateway call it makes authenticates with LITELLM_API_KEY above.
# Leave it blank here and pass --admin-key or export it for the onboarding run, so the
# long-lived service process holds no master key.
LITELLM_ADMIN_KEY=

# --- Protocols --------------------------------------------------------------
# Nothing to configure. At startup the orchestrator asks the gateway what is
# registered (GET /v1/agents, GET /v1/mcp/server + /mcp-rest/tools/list) and routes
# to whatever it finds. An empty or forbidden surface contributes no targets.
#
# Optional narrowing only (leave unset): PROTOCOLS=a2a  and/or  MCP_SERVERS=server_a

# parses both the 1.0 and legacy 0.3 response envelopes.

# --- Planner ----------------------------------------------------------------
# The single place routing happens. There is no heuristic fallback: if no model is
# named here the orchestrator refuses to plan rather than guessing.
PLANNER_MODEL=
PLANNER_TEMPERATURE=0


# --- Model targets ----------------------------------------------------------
# LiteLLM models exposed as ROUTABLE TARGETS, so the planner can choose one alongside
# A2A agents and MCP tools. Empty = only agents and tools are routable.
#
# `mai` is a gateway model (registered with POST /model/new). Being on the gateway does
# not make it routable — it must be listed here as well.
#
# Entry format is "model|description" the pipe keeps the description intact even when it
# contains punctuation and colons. Separate multiple entries with a semicolon, so a
# description may still contain commas. Keep each description narrow — the coverage gate
# and planner decide fitness from it.
#
#   Ex:- MODEL_TARGETS=mai|The MAI agent: Alstom corporate facts only, company name and main office location.;openai/gpt-4o-mini|General-purpose fallback for questions no agent or tool covers.
#
MODEL_TARGETS=

# Text a model target uses to decline. A match marks the invocation FAILED so merge
# reports the refusal instead of passing it through as an answer.
#
# Heuristic by design — a model can always decline in words not listed here. A
# first-person capability-negative pattern ("I do not/cannot … have/provide/cover")
# is matched as a second layer regardless of this list. Applies to `model` targets
# only, never to A2A agents or MCP tools.
#
# Comma-separated. Leave unset to accept the built-in list.
REFUSAL_MARKERS=

# --- Routing limits ---------------------------------------------------------
# Retrieval: the gateway ranks agents/tools against the user's message.
#   RETRIEVAL_ENABLED=false lists the whole catalogue instead (debugging only).
# Falls back per protocol when a search surface is not configured:
#   A2A needs litellm_settings.agent_search_embedding_model (config.yaml + restart)
#   MCP needs mcp_tool_search_enabled on the key (settable via /key/update)
# Both are configured on this stack; /v1/capabilities on the orchestrator reports state.
RETRIEVAL_ENABLED=true
# How many targets retrieval asks each surface for, per protocol (8 agents + 8 tools).
RETRIEVAL_TOP_K=8
# Ceiling on candidates handed to the coverage gate, applied per protocol when
# listing (search already bounds itself). The planner only sees what the gate
# passes through, which is always fewer.
CANDIDATE_MAX_TARGETS=40
# Ceiling on how many tasks execute in one turn (parallel fan-out).
# The planner may propose more; the extras are dropped.
MAX_AGENTS_PER_REQUEST=4
REQUEST_TIMEOUT_S=60
# How long a fetched agent catalogue is reused before refetching.
CARD_CACHE_TTL_S=300
# How long a search surface reporting "not configured" stays marked unavailable.
# Separate from the catalogue TTL: a different trade (probe cost vs list freshness).
SEARCH_UNAVAILABLE_TTL_S=60

# Searching with the literal message fails for follow-ups ("and in 2016?") and for messages
# with several questions. Before searching, one cheap model call turns the message and the
# recent conversation into standalone queries (one per question); results are merged by
# reciprocal rank fusion. Only runs when the message needs it. Empty model = GATE_MODEL.
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MODEL=
QUERY_REWRITE_MAX_QUERIES=4
# Keep this at or above MAX_AGENTS_PER_REQUEST: each query is what makes one sub-question
# findable, so a lower cap leaves the extra questions unsearched (a warning is logged).
# A transient search error (timeout, 429, 5xx) is retried this many times, then the turn is
# listed without search for that turn only. "Search not configured" is handled separately
# (see SEARCH_UNAVAILABLE_TTL_S above).
SEARCH_RETRIES=1
SEARCH_RETRY_BACKOFF_S=0.25

# --- Coverage gate ----------------------------------------------------------
# One LLM call asking whether any target can answer, before planning.
# Empty GATE_MODEL = planner.
# (Formerly RELEVANCE_GATE_ENABLED; the old name is still accepted.)
COVERAGE_GATE_ENABLED=true
GATE_MODEL=
# After startup, ask the gateway to serve one token with PLANNER_MODEL/GATE_MODEL.
# Runs in the background so boot never waits on the gateway. Result appears on
# /health as models.status: ok | degraded | failed (pending until it finishes).
# /v1/models is only a hint: wildcard keys may call unlisted models.
MODEL_PREFLIGHT_ENABLED=true

# =============================================================================
# Policy — read-only, no human in the loop
# =============================================================================
# true  -> the planner is asked to refuse create/update/delete/approve requests
# false -> a mutation verdict is ignored (not recommended: there is no approval flow)
READ_ONLY_MODE=true
# Optional override of the refusal text. Leave blank to use the built-in message.
READ_ONLY_DENIAL_MESSAGE=

# =============================================================================
# Memory — conversation state, one thread per conversation
# =============================================================================
# memory   -> LangGraph InMemorySaver (default; lost on restart)
# postgres -> AsyncPostgresSaver (phase 2; pip install -e ".[postgres]")
CHECKPOINT_BACKEND=memory
# postgresql://user:pass@host:5432/dbname
# The path segment IS the database name — there is no separate setting. Omitting it
# makes libpq fall back to the USER name, which silently puts checkpoint tables in the
# maintenance database. See "Which database?" in README.md.
POSTGRES_DSN=
# Create the database and the LangGraph tables on first boot. Tables are always created;
# this also covers the *database*, which otherwise fails with
# 'database "<name>" does not exist' before any table exists.
# Set 0 - False where the role has no CREATEDB (managed Postgres, locked-down prod).
POSTGRES_AUTO_CREATE=1
HISTORY_MAX_TURNS=6

# =============================================================================
# Tracing — Langfuse v4, ONE trace per conversation
# =============================================================================
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# Self-hosted example: https://langfuse.your-domain.example
# Cloud example: https://cloud.langfuse.com (EU) / https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACE_NAME=a2a-orchestrator
# Filter dimension in Langfuse. Use dev | staging | prod (lowercase, digits,
# "-" or "_", max 40, must not start with "langfuse"). A new value creates a
# NEW environment — existing traces keep their old label.
LANGFUSE_ENVIRONMENT=dev
# Which identity attribute becomes Langfuse's userId (per-user trace filtering).
# Valid: oid (default) | name | email | tenant_id | roles. Anything else is a getattr()
# miss that silently falls back to oid, so an invalid value now warns at startup.
LANGFUSE_USER_ID_FIELD=oid
# Derive the trace id from the conversation id (one trace, many turns).
TRACE_PER_CONVERSATION=true

# =============================================================================
# Identity
# dev        -> locally signed HS256 tokens shaped like Entra (no tenant needed)
# entra      -> validate a forwarded Entra token against the tenant JWKS
# shared_key -> LibreChat integration: one shared key authenticates the caller and an
#               UNSIGNED header names the user. Key holders can impersonate any user;
#               read docs/sso-integration.md before choosing this.
# none       -> no auth (localhost experiments only)
AUTH_MODE=dev

# Shared-key mode (AUTH_MODE=shared_key)
# The value LibreChat sends as apiKey: ''. Minimum 32 characters.
ORCH_SHARED_KEY=
# Role(s) stamped on every shared-key caller. Shape-compatible with an Entra token's
# `roles` claim. Grants nothing by itself: `shared_key` mode has no role gate.
SHARED_KEY_ROLES=AgentUser
# Header names carrying the caller's identity. These are a contract with the front end,
# so they match the LibreChat template variables
# ({{LIBRECHAT_USER_ID}}, {{LIBRECHAT_USER_EMAIL}}, {{LIBRECHAT_USER_NAME}}).
# Change them only if librechat.yaml sends different names. The ID header is REQUIRED
# (401 without it); email and name are optional enrichment — email feeds
# LANGFUSE_USER_ID_FIELD, name personalises greetings.
USER_ID_HEADER=x-librechat-user-id
USER_EMAIL_HEADER=x-librechat-user-email
USER_NAME_HEADER=x-librechat-user-name

# Dev mode (AUTH_MODE=dev)
DEV_JWT_SECRET=dev-only-not-a-secret-change-me-32bytes-minimum
DEV_JWT_AUDIENCE=api://orchestrator
DEV_JWT_ISSUER=http://localhost/dev-idp

# Entra mode (AUTH_MODE=entra)
# Standalone:           ENTRA_AUDIENCE=api://<orchestrator-app-id>
# Behind LibreChat SSO: ENTRA_AUDIENCE=api://librechat  (leave ENTRA_REQUIRED_ROLE empty)
# ENTRA_TENANT_ID=
# ENTRA_AUDIENCE=
# ENTRA_REQUIRED_ROLE=

# =============================================================================
# Small talk - greetings, thanks, "what can you do?"
# =============================================================================
# Answered directly: no model call, no target. Personalised from the user's
# display name when one is usable; an email or opaque id greets neutrally.
SMALLTALK_ENABLED=true
# Optional override for the capabilities answer. Blank = built-in text.
SMALLTALK_CAPABILITIES_REPLY=
